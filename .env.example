# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is gitignored and must stay that way. Never paste these values into a
# chat, an issue, or a commit. If a secret is ever exposed, rotate it in the
# WHOOP developer dashboard rather than hoping nobody noticed.

# From the WHOOP developer dashboard, after creating your app.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match a Redirect URL registered on the app, character for character.
WHOOP_REDIRECT_URI=http://localhost:8080/callback

# Written by the auth flow after you authorise once; refreshed automatically
# from then on. Leave blank initially.
WHOOP_REFRESH_TOKEN=

# For the model that produces the coaching advice being evaluated.
ANTHROPIC_API_KEY=

# Where local data lives. Gitignored; nothing here is ever committed.
COACH_EVAL_DATA_DIR=./data
